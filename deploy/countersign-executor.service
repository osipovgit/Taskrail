[Unit]
Description=Countersign isolated SSH executor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=countersign-executor
Group=countersign-executor
SupplementaryGroups=countersign-executor-clients
ExecStart=/opt/countersign-executor/deploy/executor-service --client-uid=@CLIENT_UID@
RuntimeDirectory=countersign-executor
RuntimeDirectoryMode=0755
StateDirectory=countersign-executor
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=yes
LimitFSIZE=8M
TasksMax=64
MemoryMax=512M

[Install]
WantedBy=multi-user.target
