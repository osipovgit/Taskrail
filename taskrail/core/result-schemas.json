{
  "planner": {
    "type": "object",
    "required": [
      "schema_version",
      "status",
      "summary",
      "coverage",
      "evidence",
      "unverified",
      "blocking_gaps",
      "steps",
      "files_read",
      "proposed_change_files",
      "decision"
    ],
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "type": "integer",
        "enum": [
          1
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "PLAN_READY",
          "BLOCKED"
        ]
      },
      "summary": {
        "type": "string",
        "minLength": 1
      },
      "coverage": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "outcome",
            "evidence_ids",
            "explanation"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "type": "string",
              "enum": [
                "satisfied",
                "planned",
                "deferred",
                "gap",
                "contradicted",
                "not_evaluated",
                "not_applicable"
              ]
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "explanation": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "path",
            "line_start",
            "line_end"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "line_start": {
              "type": "integer",
              "minimum": 1
            },
            "line_end": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "unverified": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "blocking_gaps": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "steps": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "action",
            "files",
            "criteria",
            "depends_on",
            "checks",
            "title",
            "line",
            "scopes",
            "done_when",
            "notes"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "action": {
              "type": "string",
              "minLength": 1
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "criteria": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "depends_on": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "scope"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scope": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "done_when": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "notes": {
              "type": "string"
            },
            "read": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "files_read": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "proposed_change_files": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "decision": {
        "type": "string",
        "enum": [
          "split",
          "single",
          "none",
          "blocked"
        ]
      },
      "check_selections": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "recipe_id",
            "criteria"
          ],
          "additionalProperties": false,
          "properties": {
            "recipe_id": {
              "type": "string",
              "minLength": 1
            },
            "criteria": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "git-request": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "status",
      "root",
      "argv",
      "reason"
    ],
    "properties": {
      "schema_version": {
        "const": 1
      },
      "status": {
        "const": "GIT_REQUEST"
      },
      "root": {
        "type": "string",
        "minLength": 1
      },
      "argv": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "reason": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "local-request": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "status",
      "cwd",
      "argv",
      "reason"
    ],
    "properties": {
      "schema_version": {
        "const": 1
      },
      "status": {
        "const": "LOCAL_REQUEST"
      },
      "cwd": {
        "type": "string",
        "minLength": 1
      },
      "argv": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "reason": {
        "type": "string",
        "minLength": 1
      },
      "sandbox": {
        "type": "boolean"
      }
    }
  },
  "ssh-request": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "status",
      "action"
    ],
    "properties": {
      "schema_version": {
        "const": 1
      },
      "status": {
        "const": "ACTION_REQUEST"
      },
      "action": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "targets",
          "script",
          "reason",
          "files",
          "timeout_seconds"
        ],
        "properties": {
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "script": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          }
        }
      }
    }
  },
  "jenkins-request": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "status",
      "jenkins"
    ],
    "properties": {
      "schema_version": {
        "const": 1
      },
      "status": {
        "const": "JENKINS_REQUEST"
      },
      "jenkins": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "server",
          "job",
          "operation",
          "build",
          "parameters",
          "reason",
          "timeout_seconds"
        ],
        "properties": {
          "server": {
            "type": "string",
            "minLength": 1
          },
          "job": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "enum": [
              "status",
              "console",
              "tests",
              "build"
            ]
          },
          "build": {
            "oneOf": [
              {
                "enum": [
                  "last",
                  "new"
                ]
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ]
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          }
        }
      }
    }
  }
}
