{
  "planner": {
    "type": "object",
    "required": [
      "schema_version",
      "status",
      "summary",
      "coverage",
      "evidence",
      "unverified",
      "blocking_gaps",
      "steps",
      "files_read",
      "proposed_change_files",
      "decision"
    ],
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "type": "integer",
        "enum": [
          1
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "PLAN_READY",
          "BLOCKED"
        ]
      },
      "summary": {
        "type": "string",
        "minLength": 1
      },
      "coverage": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "outcome",
            "evidence_ids",
            "explanation"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "type": "string",
              "enum": [
                "satisfied",
                "planned",
                "deferred",
                "gap",
                "contradicted",
                "not_evaluated"
              ]
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "explanation": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "path",
            "line_start",
            "line_end"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "line_start": {
              "type": "integer",
              "minimum": 1
            },
            "line_end": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "unverified": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "blocking_gaps": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "steps": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "action",
            "files",
            "criteria",
            "depends_on",
            "checks",
            "title",
            "line",
            "scopes",
            "done_when",
            "notes"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "action": {
              "type": "string",
              "minLength": 1
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "criteria": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "depends_on": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "scope"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scope": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "done_when": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "notes": {
              "type": "string"
            },
            "read": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "files_read": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "proposed_change_files": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "decision": {
        "type": "string",
        "enum": [
          "split",
          "single",
          "none",
          "blocked"
        ]
      },
      "check_selections": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "recipe_id",
            "criteria"
          ],
          "additionalProperties": false,
          "properties": {
            "recipe_id": {
              "type": "string",
              "minLength": 1
            },
            "criteria": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "decision": {
    "type": "object",
    "required": [
      "schema_version",
      "outcomes",
      "findings",
      "missing_inputs"
    ],
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "type": "integer",
        "enum": [
          2
        ]
      },
      "outcomes": {
        "type": "array",
        "maxItems": 500,
        "items": {
          "type": "object",
          "required": [
            "requirement",
            "result",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "requirement": {
              "type": "string",
              "minLength": 1
            },
            "result": {
              "type": "string",
              "enum": [
                "satisfied",
                "planned",
                "deferred",
                "gap",
                "contradicted",
                "not_evaluated"
              ]
            },
            "evidence": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        }
      },
      "findings": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "object",
          "required": [
            "requirement",
            "evidence",
            "problem"
          ],
          "additionalProperties": false,
          "properties": {
            "requirement": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "problem": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        }
      },
      "missing_inputs": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "summary": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    }
  },
  "implementer-decision": {
    "type": "object",
    "required": [
      "schema_version",
      "outcomes",
      "missing_inputs"
    ],
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "type": "integer",
        "enum": [
          2
        ]
      },
      "outcomes": {
        "type": "array",
        "maxItems": 500,
        "items": {
          "type": "object",
          "required": [
            "requirement",
            "result",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "requirement": {
              "type": "string",
              "minLength": 1
            },
            "result": {
              "type": "string",
              "enum": [
                "satisfied",
                "deferred",
                "gap",
                "contradicted",
                "not_evaluated"
              ]
            },
            "evidence": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        }
      },
      "missing_inputs": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "summary": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    }
  }
}
